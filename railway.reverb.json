{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.reverb"
  },
  "deploy": {
    "startCommand": "/entrypoint-reverb.sh php artisan reverb:start --host=0.0.0.0 --port=8080 --no-interaction",
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
